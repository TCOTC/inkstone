{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "minimum_chrome_version": "130",
  "version": "0.1.0",
  "name": "Inkstone",
  "description": "Chrome 扩展，支持在网页划选文字高亮、翻译、解释",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "permissions": ["storage", "contextMenus", "alarms", "clipboardWrite", "scripting", "activeTab"],
  "host_permissions": ["https://api.deepseek.com/*"],
  "optional_host_permissions": ["https://github.com/*", "https://api.github.com/*"],
  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    },
    "default_title": "Inkstone"
  },
  "background": {
    "service_worker": "background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.ts"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "pages/app.html"
}
